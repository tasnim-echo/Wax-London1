<div class="image-grid">
  {% for block in section.blocks %}
    <div class="image-grid__item" {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.title }}"
        >
      {% endif %}

      <div class="overlay">
        <h2>{{ block.settings.title }}</h2>

        <a href="{{ block.settings.link }}" class="btn">
          {{ block.settings.button_text }}
        </a>
      </div>
    </div>
  {% endfor %}
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 0 10px;
  }

  .image-grid__item {
    position: relative;
    overflow: hidden;
  }

  .image-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 30px;
    color: white;
  }

  .overlay h2 {
    color: #fff;
    font-size: 36px;
    margin: 0;
    font-family: 'ITCClearface';
    line-height: 45px;
    font-weight: 700;
    margin-bottom: -8px;
  }

  .btn {
    display: inline-block;
    color: #333333;
    background: #ffffff;
    padding: 11px 25px;
    font-size: 13px;
    line-height: 17px;
    font-weight: 500;
    border-radius: 80px;
    margin-left: 10px;
    min-width: 111px;
    text-decoration: none;
  }
</style>

{% schema %}
{
  "name": "Image Grid Section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shirts"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Grid Section"
    }
  ]
}
{% endschema %}
