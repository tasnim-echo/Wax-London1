<div class="recently-viewed">
  <div class="recently-viewed-header">
    <h2>Recently Viewed</h2>

    <div class="recently-viewed-nav">
      <button class="recently-prev">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="arrow-icon"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button class="recently-next">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="arrow-icon"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>
  </div>

  <div class="swiper recently-viewed-slider">
    <div class="swiper-wrapper" id="recently-viewed-wrapper"></div>
  </div>
</div>

<style>
  .recently-viewed-card {
    overflow: hidden;
  }

  .recently-viewed-card a {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .rv-primary,
  .rv-secondary {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
    transition: opacity 0.35s ease;
  }

  .rv-primary {
    position: relative;
    z-index: 1;
  }

  .rv-secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 2;
  }

  .recently-viewed-card a:hover .rv-primary {
    opacity: 0;
  }

  .recently-viewed-card a:hover .rv-secondary {
    opacity: 1;
  }

  /* Product info */

  .rv-image {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .rv-sizes {
    position: absolute;
    left: 0;
    bottom: -100%;
    width: 100%;

    background: #fff;

    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;

    padding: 12px;

    transition: bottom 0.3s ease;
    z-index: 3;
  }

  .rv-sizes span {
    font-size: 14px;
    font-weight: 500;
    color: #000;
  }

  .rv-image:hover .rv-sizes {
    bottom: 0;
  }

  .recently-viewed-card h3 {
    margin-top: 16px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }

  .recently-viewed-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .recently-viewed-card p {
    margin-top: 8px;
    font-size: 16px;
    font-weight: 600;
  }

  .recently-viewed-header h2 {
    text-align: center;
    margin-bottom: 70px;
    font-size: 36px;
    line-height: 41px;
    font-weight: 700;
    font-family: 'ITCClearface', serif;
  }
  .recently-viewed {
    margin: 0 90px;
    position: relative;
  }

  .recently-viewed-nav button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);

    display: flex;
    align-items: center;
    justify-content: center;

    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
    padding: 0;
    margin: 0;

    cursor: pointer;
    z-index: 10;
  }

  .recently-prev {
    left: -40px;
  }

  .recently-next {
    right: -40px;
  }

  .arrow-icon {
    width: 45px;
    height: 45px;
  }

  .recently-viewed-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .recently-viewed-card h3 {
    margin-top: 12px;
    font-size: 16px;
  }

  .recently-viewed-card p {
    margin-top: 6px;
    font-weight: 600;
  }

  .recently-viewed-nav .swiper-button-disabled {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const recentlySwiper = new Swiper('.recently-viewed-slider', {
    slidesPerView: 4,
    slidesPerGroup: 4,
    spaceBetween: 24,

    navigation: {
      nextEl: '.recently-next',
      prevEl: '.recently-prev',
    },

    watchOverflow: true,
  });

  document.addEventListener('DOMContentLoaded', async () => {
    const viewed = JSON.parse(sessionStorage.getItem('recentlyViewed')) || [];

    if (viewed) {
      console.log(viewed);
    } else {
      console.log('No recently viewed products found.');
    }

    const wrapper = document.getElementById('recently-viewed-wrapper');

    for (const handle of viewed) {
      try {
        const response = await fetch(`/products/${handle}.js`);
        const product = await response.json();

        const primaryImage = product.images[0];
        const secondaryImage = product.images[1] || product.images[0];
        const sizes = [...new Set(product.variants.map((variant) => variant.option1))]
          .map((size) => `<span>${size}</span>`)
          .join('');

        wrapper.innerHTML += `
      <div class="swiper-slide">
        <div class="recently-viewed-card">

              <a href="/products/${product.handle}" class="rv-image">
              
                <img
                  class="rv-primary"
                  src="${primaryImage}"
                  alt="${product.title}"
                >
              
                <img
                  class="rv-secondary"
                  src="${secondaryImage}"
                  alt="${product.title}"
                >
              
                <div class="rv-sizes">
                  ${sizes}
                </div>
              
              </a>

          <h3>${product.title}</h3>

          <p>$${(product.price / 100).toFixed(2)}</p>

        </div>
      </div>
    `;
      } catch (error) {
        console.error(error);
      }
    }
  });
</script>
