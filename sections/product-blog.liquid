<div class="blog-slider-section">
  <div class="blog-slider-header">
    <h2>{{ section.settings.heading }}</h2>

    <div class="blog-slider-nav">
      <button class="blog-prev">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          width="24"
          height="24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button class="blog-next">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          width="24"
          height="24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>
  </div>

  <div class="swiper blog-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="slide-card">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.heading }}"
              >
            {% endif %}

            <h3>{{ block.settings.heading }}</h3>

            <p>
              {{ block.settings.text | truncate: block.settings.text_limit }}
            </p>

            <a class="read_more" href="{{ block.settings.link }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .blog-slider-section {
    padding: 24px 10px;
  }

  .blog-slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 16px;
  }
  .blog-slider-header h2 {
    font-family: serif;
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    padding: 0 10px;
  }

  .blog-slider-nav {
    display: flex;
  }

  .blog-slider-nav button {
    cursor: pointer;
  }

  .slide-card {
    aspect-ratio: 1/1;
  }
  .slide-card img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .slide-card h3 {
    margin-top: 16px;
  }

  .blog-slider-nav button {
    background: transparent;
    border: 2.5px solid transparent;
    width: 52px;
    height: 52px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .blog-slider-nav button.is-active {
    border-color: #007aff;
  }
  .read_more {
    position: relative;
    display: inline-block;
    color: #000000;
    text-decoration: none;
  }

  .read_more::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0px;
    width: 100%;
    height: 1px;
    background: #000000;

    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .read_more:hover::after {
    transform: scaleX(0);
  }
</style>

<script>
  new Swiper('.blog-swiper', {
    slidesPerView: 3.5,
    spaceBetween: 10,

    navigation: {
      nextEl: '.blog-next',
      prevEl: '.blog-prev',
    },

    breakpoints: {
      0: {
        slidesPerView: 1.2,
      },
      768: {
        slidesPerView: 2.2,
      },
      1200: {
        slidesPerView: 3.5,
      },
    },
  });

  const prevBtn = document.querySelector('.blog-prev');
  const nextBtn = document.querySelector('.blog-next');

  nextBtn.addEventListener('click', () => {
    nextBtn.classList.add('is-active');
    prevBtn.classList.remove('is-active');
  });

  prevBtn.addEventListener('click', () => {
    prevBtn.classList.add('is-active');
    nextBtn.classList.remove('is-active');
  });
</script>
{% schema %}
{
  "name": "Article Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "DISCOVER MORE"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Article Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Write a short description here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Read More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "range",
          "id": "text_limit",
          "label": "Text length",
          "min": 20,
          "max": 300,
          "step": 5,
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
